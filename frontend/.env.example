# Base URL of the MedBook backend REST API.
#
# With `npm run dev` you can leave this unset: Vite proxies same-origin /api requests to
# http://localhost:8080 (see vite.config.ts), which avoids CORS setup during development.
#
# Point it at a backend running elsewhere by uncommenting:
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Only the PUBLIC API base URL belongs here. Never put JWT secrets, database credentials,
# or any other backend secret into a Vite env file: everything under VITE_ is embedded into
# the browser bundle and readable by anyone who loads the page.
